# =============================================================================
# Crime Intelligence Frontend — Environment Variables
# =============================================================================
# Copy this file to .env inside artifacts/crime-intelligence/ to override defaults.
# The dev server runs on PORT 3000 at BASE_PATH / by default — no changes needed.
# =============================================================================

# Port the Vite dev server listens on.
PORT=3000

# URL base path for the app. Use "/" for local development.
# In Replit this is set automatically to the artifact's path prefix.
BASE_PATH=/
